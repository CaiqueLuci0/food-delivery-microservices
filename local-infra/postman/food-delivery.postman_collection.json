            {
              "name": "Update User",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"João Silva Atualizado\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/user-ms/users/{{userId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["user-ms", "users", "{{userId}}"]
                }
              }
            },
            {
              "name": "Delete User",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/user-ms/users/{{userId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["user-ms", "users", "{{userId}}"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Restaurant MS",
      "item": [
        {
          "name": "Restaurants",
          "item": [
            {
              "name": "Create Restaurant",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  if (json.id) {",
                      "    pm.collectionVariables.set('restaurantId', json.id);",
                      "  }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Pizzaria Centro\",\n  \"description\": \"Pizza artesanal\",\n  \"address\": {\n    \"cep\": \"01001000\",\n    \"logradouro\": \"Praça da Sé\",\n    \"numero\": \"100\",\n    \"complemento\": \"Loja 1\",\n    \"bairro\": \"Sé\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"referencia\": \"Próximo ao metrô\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants"]
                }
              }
            },
            {
              "name": "List Restaurants",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants"]
                }
              }
            },
            {
              "name": "Search Restaurants",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants?search=pizza",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants"],
                  "query": [
                    {
                      "key": "search",
                      "value": "pizza"
                    }
                  ]
                }
              }
            },
            {
              "name": "Search Restaurants By Location",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants?latitude=-23.5505&longitude=-46.6333",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants"],
                  "query": [
                    {
                      "key": "latitude",
                      "value": "-23.5505"
                    },
                    {
                      "key": "longitude",
                      "value": "-46.6333"
                    }
                  ]
                }
              }
            },
            {
              "name": "Get Restaurant By Id",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants/{{restaurantId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants", "{{restaurantId}}"]
                }
              }
            },
            {
              "name": "Update Restaurant",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Pizzaria Centro Atualizada\",\n  \"description\": \"Pizza artesanal e massas\",\n  \"address\": {\n    \"cep\": \"01001000\",\n    \"logradouro\": \"Praça da Sé\",\n    \"numero\": \"200\",\n    \"complemento\": \"Loja 2\",\n    \"bairro\": \"Sé\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"referencia\": \"Esquina\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants/{{restaurantId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants", "{{restaurantId}}"]
                }
              }
            },
            {
              "name": "Delete Restaurant",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/restaurant-ms/restaurants/{{restaurantId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["restaurant-ms", "restaurants", "{{restaurantId}}"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalog MS",
      "item": [
        {
          "name": "Products",
          "item": [
            {
              "name": "Create Product",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  if (json.id) {",
                      "    pm.collectionVariables.set('productId', json.id);",
                      "  }",
                      "  if (json.specifications && json.specifications[0] && json.specifications[0].specOptions && json.specifications[0].specOptions[0]) {",
                      "    pm.collectionVariables.set('specOptionId', json.specifications[0].specOptions[0].id);",
                      "  }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Pizza Margherita\",\n  \"price\": 45.9,\n  \"description\": \"Mussarela e manjericão\",\n  \"specifications\": [\n    {\n      \"name\": \"Tamanho\",\n      \"description\": \"Escolha o tamanho\",\n      \"specOptions\": [\n        {\n          \"name\": \"Média\",\n          \"description\": \"30cm\",\n          \"extraPrice\": 0\n        },\n        {\n          \"name\": \"Grande\",\n          \"description\": \"40cm\",\n          \"extraPrice\": 10\n        }\n      ]\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products"]
                }
              }
            },
            {
              "name": "List Products By Restaurant",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products?restaurantId={{restaurantId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products"],
                  "query": [
                    {
                      "key": "restaurantId",
                      "value": "{{restaurantId}}"
                    }
                  ]
                }
              }
            },
            {
              "name": "Search Products",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products?restaurantId={{restaurantId}}&search=pizza",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products"],
                  "query": [
                    {
                      "key": "restaurantId",
                      "value": "{{restaurantId}}"
                    },
                    {
                      "key": "search",
                      "value": "pizza"
                    }
                  ]
                }
              }
            },
            {
              "name": "Get Product By Id",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products/{{productId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products", "{{productId}}"]
                }
              }
            },
            {
              "name": "Update Product",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Pizza Margherita Especial\",\n  \"price\": 49.9,\n  \"description\": \"Mussarela, manjericão e tomate\",\n  \"specifications\": [\n    {\n      \"name\": \"Tamanho\",\n      \"description\": \"Escolha o tamanho\",\n      \"specOptions\": [\n        {\n          \"name\": \"Família\",\n          \"description\": \"50cm\",\n          \"extraPrice\": 20\n        }\n      ]\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products/{{productId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products", "{{productId}}"]
                }
              }
            },
            {
              "name": "Resolve Product",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"specOptionIds\": [\"{{specOptionId}}\"]\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products/resolve",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products", "resolve"]
                }
              }
            },
            {
              "name": "Delete Product",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/catalog-ms/products/{{productId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["catalog-ms", "products", "{{productId}}"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Order MS",
      "item": [
        {
          "name": "Orders",
          "item": [
            {
              "name": "Create Order",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  if (json.id) {",
                      "    pm.collectionVariables.set('orderId', json.id);",
                      "  }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"specOptionIds\": [\"{{specOptionId}}\"]\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders"]
                }
              }
            },
            {
              "name": "Update Order Items",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"specOptionIds\": [\"{{specOptionId}}\"]\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders/{{orderId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders", "{{orderId}}"]
                }
              }
            },
            {
              "name": "Finalize Order",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders/{{orderId}}/finalize",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders", "{{orderId}}", "finalize"]
                }
              }
            },
            {
              "name": "Update Order Status",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"PREPARANDO\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders/{{orderId}}/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders", "{{orderId}}", "status"]
                }
              }
            },
            {
              "name": "Cancel Order",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders/{{orderId}}/cancel",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders", "{{orderId}}", "cancel"]
                }
              }
            },
            {
              "name": "Get Order By Id",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders/{{orderId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders", "{{orderId}}"]
                }
              }
            },
            {
              "name": "List My Orders",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders"]
                }
              }
            },
            {
              "name": "List Orders By Restaurant",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/order-ms/orders?restaurantId={{restaurantId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["order-ms", "orders"],
                  "query": [
                    {
                      "key": "restaurantId",
                      "value": "{{restaurantId}}"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payment MS",
      "item": [
        {
          "name": "Mark Payment As Paid",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment-ms/payments/{{orderId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["payment-ms", "payments", "{{orderId}}", "pay"]
            }
          }
        }
      ]
    }
  ]
}
