<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user-reference" author="order-ms">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_reference"/>
            </not>
        </preConditions>
        <createTable tableName="user_reference">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_reference"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-order" author="order-ms">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="order"/>
            </not>
        </preConditions>
        <createTable tableName="order">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_order"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="varchar(50)"/>
            <column name="score" type="double"/>
            <column name="restaurant_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="restaurant_owner_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="uuid"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="order"
                baseColumnNames="client_id"
                referencedTableName="user_reference"
                referencedColumnNames="id"
                constraintName="fk_order_user_reference"
                onDelete="SET NULL"/>
    </changeSet>

    <changeSet id="001-create-product-snapshot" author="order-ms">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product_snapshot"/>
            </not>
        </preConditions>
        <createTable tableName="product_snapshot">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_product_snapshot"/>
            </column>
            <column name="name" type="varchar(255)"/>
            <column name="price" type="double"/>
            <column name="description" type="varchar(255)"/>
            <column name="order_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="product_snapshot"
                baseColumnNames="order_id"
                referencedTableName="order"
                referencedColumnNames="id"
                constraintName="fk_product_snapshot_order"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="001-create-spec-option-snapshot" author="order-ms">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="spec_option_snapshot"/>
            </not>
        </preConditions>
        <createTable tableName="spec_option_snapshot">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_spec_option_snapshot"/>
            </column>
            <column name="name" type="varchar(255)"/>
            <column name="description" type="varchar(255)"/>
            <column name="extra_price" type="double"/>
            <column name="prod_snapshot_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="spec_option_snapshot"
                baseColumnNames="prod_snapshot_id"
                referencedTableName="product_snapshot"
                referencedColumnNames="id"
                constraintName="fk_spec_option_snapshot_product_snapshot"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
